{
  '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':automergeMinor',
    ':automergeBranch',
  ],
  commitMessageAction: '⬆ upgrade',
  schedule: ['* * 1-7,14-21 * 4'], 
  timezone: 'America/Toronto',
  packageRules: [
    {
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest'],
      groupName: 'all dependencies',
      groupSlug: 'all-deps'
    },
    {
      matchPackageNames: ['org.jetbrains.kotlinx:kotlinx-datetime'],
      allowedVersions: '!/compat/',
    },
    {
      // 1.1.2 fails the scene ownership test after resize/pop; root cause is unconfirmed.
      matchPackageNames: [
        'org.jetbrains.androidx.navigation3:navigation3-ui',
        'org.jetbrains.androidx.navigation3:navigation3-runtime',
      ],
      allowedVersions: '!/^1[.]1[.]2$/',
    }
  ],
}
